@{ ViewData["Title"] = "Cài đặt"; var account=(HumaHr.Models.AppUser?)ViewBag.CurrentAccount; }
<section class="welcome-row"><div><div class="eyebrow"><span class="eyebrow-dot"></span> TÀI KHOẢN</div><h1>Cài đặt tài khoản</h1><p class="page-subtitle">Thông tin đăng nhập hiện tại của bạn.</p></div></section>
<section class="panel info-panel"><h2>Thông tin tài khoản</h2><dl><dt>Họ và tên</dt><dd>@(account?.FullName ?? User.Identity?.Name)</dd><dt>Email</dt><dd>@(account?.Email ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value)</dd><dt>Vai trò</dt><dd>@(User.IsInRole("Admin") ? "Quản trị viên" : "Nhân viên")</dd></dl><div class="form-actions"><a class="btn-outline" asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn-outline" type="submit">Đăng xuất</button></form></div></section>
