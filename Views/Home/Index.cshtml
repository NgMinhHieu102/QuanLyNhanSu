@using HumaHr.Models
@{ ViewData["Title"] = "Tổng quan"; var data=(HrData)ViewBag.Data; var totalSalary=data.Payrolls.Sum(x=>x.NetSalary); var attendanceRate=data.Attendances.Count==0?0:(int)Math.Round(data.Attendances.Count(x=>x.Status=="Có mặt")*100.0/data.Attendances.Count); var previousCount=(int)ViewBag.EmployeeCountLastMonth; var employeeDelta=data.Employees.Count-previousCount; }
<section class="welcome-row"><div><div class="eyebrow"><span class="eyebrow-dot"></span> @DateTime.Today.ToString("dddd, dd 'tháng' MM, yyyy").ToUpperInvariant()</div><h1>Chào buổi sáng, Tiến Đạt <span class="wave">✦</span></h1><p class="page-subtitle">Đây là những gì đang diễn ra với đội ngũ của bạn hôm nay.</p></div><a class="btn-primary" asp-action="Employee"><span>＋</span> Thêm nhân viên</a></section>
<section class="stats-grid">
<article class="stat-card"><div class="stat-head"><span>Tổng nhân viên</span><span class="stat-icon purple">♙</span></div><div class="stat-value">@data.Employees.Count <span>người</span></div><div class="stat-foot"><span class="trend @(employeeDelta>=0?"up":"down")">@(employeeDelta>=0?"↗ ":"↘ ")@Math.Abs(employeeDelta)</span><span>so với tháng trước</span><div class="sparkline purple-line"><i style="height:30%"></i><i style="height:46%"></i><i style="height:39%"></i><i style="height:63%"></i><i style="height:53%"></i><i style="height:73%"></i><i style="height:65%"></i><i style="height:91%"></i></div></div></article>
<article class="stat-card"><div class="stat-head"><span>Đang làm việc</span><span class="stat-icon green">✓</span></div><div class="stat-value">@data.Employees.Count(x=>x.IsActive) <span>người</span></div><div class="stat-foot"><span class="muted-indicator">● @((data.Employees.Count==0?0:(int)Math.Round(data.Employees.Count(x=>x.IsActive)*100.0/data.Employees.Count)))%</span><span>trong tổng số nhân viên</span><div class="sparkline green-line"><i style="height:42%"></i><i style="height:50%"></i><i style="height:40%"></i><i style="height:68%"></i><i style="height:60%"></i><i style="height:72%"></i><i style="height:64%"></i><i style="height:87%"></i></div></div></article>
<article class="stat-card"><div class="stat-head"><span>Phòng ban</span><span class="stat-icon blue">▦</span></div><div class="stat-value">@data.Departments.Count <span>phòng ban</span></div><div class="stat-foot"><span class="muted-indicator">● Ổn định</span><span>so với tháng trước</span><div class="sparkline blue-line"><i style="height:48%"></i><i style="height:48%"></i><i style="height:48%"></i><i style="height:70%"></i><i style="height:70%"></i><i style="height:70%"></i><i style="height:88%"></i><i style="height:88%"></i></div></div></article>
<article class="stat-card"><div class="stat-head"><span>Quỹ lương đã công bố (@ViewBag.PayrollPeriod)</span><span class="stat-icon orange">＄</span></div><div class="stat-value money">@totalSalary.ToString("N0") <span>₫</span></div><div class="stat-foot"><span class="muted-indicator">● @data.Payrolls.Count</span><span>bảng lương mẫu</span><div class="sparkline orange-line"><i style="height:35%"></i><i style="height:44%"></i><i style="height:40%"></i><i style="height:58%"></i><i style="height:52%"></i><i style="height:73%"></i><i style="height:67%"></i><i style="height:91%"></i></div></div></article></section>
<section class="dashboard-grid"><article class="panel"><div class="panel-heading"><div><h2>Chấm công hôm nay</h2><p>Tình hình điểm danh toàn công ty</p></div><a asp-action="Attendance" class="text-link">Xem chi tiết <span>→</span></a></div><div class="attendance-content"><div class="donut-wrap"><div class="donut" style="--rate:@attendanceRate"><div><strong>@attendanceRate%</strong><small>Tỷ lệ có mặt</small></div></div><div class="donut-caption">@DateTime.Today.ToString("dd/MM/yyyy")</div></div><div class="attendance-legend"><div><i class="legend-dot present"></i><span>Có mặt</span><strong>@data.Attendances.Count(x=>x.Status=="Có mặt")</strong></div><div><i class="legend-dot late"></i><span>Đi muộn</span><strong>@data.Attendances.Count(x=>x.IsLate)</strong></div><div><i class="legend-dot absent"></i><span>Vắng mặt</span><strong>@data.Attendances.Count(x=>x.Status=="Vắng mặt")</strong></div><div><i class="legend-dot leave"></i><span>Nghỉ phép</span><strong>@data.Attendances.Count(x=>x.Status=="Nghỉ phép")</strong></div></div></div></article>
<article class="panel"><div class="panel-heading"><div><h2>Nhân sự theo phòng ban</h2><p>Phân bổ nhân viên hiện tại</p></div><a asp-action="Departments" class="text-link">Tất cả <span>→</span></a></div><div class="department-bars">@foreach(var dep in data.Departments){var count=data.Employees.Count(x=>x.Department==dep.Name);var width=data.Employees.Count==0?0:Math.Max(8,count*100/data.Employees.Count);<div class="bar-row"><div class="bar-label"><span>@dep.Name</span><strong>@count</strong></div><div class="bar-track"><div class="bar-fill" style="width:@(width)%"></div></div></div>}</div></article></section>
<section class="panel employees-panel"><div class="panel-heading"><div><h2>Nhân viên mới</h2><p>Những thành viên vừa gia nhập đội ngũ</p></div><a asp-action="Employees" class="text-link">Tất cả nhân viên <span>→</span></a></div><div class="table-responsive"><table class="data-table"><thead><tr><th>NHÂN VIÊN</th><th>PHÒNG BAN</th><th>VỊ TRÍ</th><th>NGÀY VÀO LÀM</th><th>TRẠNG THÁI</th><th></th></tr></thead><tbody>@foreach(var e in data.Employees.OrderByDescending(x=>x.StartDate).Take(4)){<tr><td><div class="person-cell"><span class="person-avatar avatar-@((e.Id%5)+1)">@e.FullName.Split(' ').Last()[0]</span><div><strong>@e.FullName</strong><small>@e.Code</small></div></div></td><td>@e.Department</td><td>@e.Position</td><td>@e.StartDate.ToString("dd/MM/yyyy")</td><td><span class="status-pill active-pill"><i></i> Đang làm việc</span></td><td><a class="row-more" asp-action="Employee" asp-route-id="@e.Id">···</a></td></tr>}</tbody></table></div></section>
