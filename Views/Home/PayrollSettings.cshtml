@{ ViewData["Title"]="Lịch công & lương"; var s=(HumaHr.Models.PayrollSettings)ViewBag.Settings; var holidays=(List<HumaHr.Models.CompanyHoliday>)ViewBag.Holidays; var year=(int)ViewBag.Year; var names=new[]{"Thứ Hai","Thứ Ba","Thứ Tư","Thứ Năm","Thứ Sáu","Thứ Bảy","Chủ nhật"}; }
<section class="welcome-row"><div><div class="eyebrow"><span class="eyebrow-dot"></span> QUY TẮC CÔNG TY</div><h1>Lịch làm & ngày nghỉ</h1><p class="page-subtitle">Dùng để tính công chuẩn, ngày phép và phân loại giờ tăng ca cho các kỳ chưa công bố.</p></div><a class="btn-outline" asp-action="Payroll" asp-route-period="@DateTime.Today.AddMonths(-1).ToString("MM/yyyy")">← Bảng lương</a></section>
<section class="panel form-panel"><h2>Lịch làm việc chuẩn</h2><form asp-action="SavePayrollSettings" method="post"><div class="form-grid">@for(var i=0;i<names.Length;i++){<label class="checkbox-field"><input type="checkbox" name="workdays" value="@i" checked="@((s.WorkdaysMask & (1<<i))!=0)"/> @names[i] là ngày làm</label>}<label>Giờ bắt đầu<input name="workdayStart" type="time" value="@s.WorkdayStart.ToString("hh\\:mm")" required/></label><label>Giờ kết thúc<input name="workdayEnd" type="time" value="@s.WorkdayEnd.ToString("hh\\:mm")" required/></label><label>Số giờ chuẩn mỗi ngày<input name="hoursPerDay" type="number" min="1" max="12" step="0.25" value="@s.HoursPerDay" required/></label></div><div class="form-actions"><button class="btn-primary" type="submit">Lưu lịch làm</button></div></form><p class="page-subtitle">Mặc định thứ Hai–thứ Sáu, 09:00–18:00, 8 giờ công/ngày (đã trừ giờ nghỉ). Đi muộn được tính sau giờ bắt đầu cấu hình. Thay đổi chỉ ảnh hưởng kỳ lương chưa công bố.</p></section>
<section class="panel info-panel"><h2>Mức tối thiểu đang áp dụng trong phép tính</h2><dl><dt>Tăng ca ngày làm</dt><dd>@((s.RegularOvertimeRate*100).ToString("0.#"))%</dd><dt>Tăng ca ngày nghỉ tuần</dt><dd>@((s.RestOvertimeRate*100).ToString("0.#"))%</dd><dt>Tăng ca ngày lễ</dt><dd>@((s.HolidayOvertimeRate*100).ToString("0.#"))% ngoài lương ngày lễ</dd><dt>Phụ trội giờ đêm</dt><dd>@((s.NightPremiumRate*100).ToString("0.#"))%; tăng ca ban đêm cộng thêm @((s.NightOvertimeAdditionalRate*100).ToString("0.#"))%</dd><dt>Người lao động</dt><dd>@((s.EmployeeInsuranceRate*100).ToString("0.#"))% trên mức căn cứ do Admin xác nhận</dd><dt>Doanh nghiệp</dt><dd>@((s.EmployerContributionRate*100).ToString("0.#"))% chi phí riêng</dd></dl><p class="page-subtitle">Đây là mức mặc định cho lao động Việt Nam thuộc diện áp dụng. Admin phải xác nhận đối tượng, căn cứ đóng, thuế và ngoại lệ trước khi công bố lương.</p></section>
<section class="panel form-panel"><h2>Ngày lễ / ngày nghỉ công ty · @year</h2><p class="page-subtitle">Thêm ngày lễ theo lịch năm (đặc biệt Tết âm lịch), ngày nghỉ bù và ngày nghỉ riêng của công ty. Ngày này không bị yêu cầu chấm công và giờ làm được phân loại tăng ca ngày lễ.</p><form asp-action="SaveCompanyHoliday" method="post"><div class="form-grid"><label>Ngày nghỉ<input type="date" name="date" value="@($"{year}-01-01")" required/></label><label>Tên ngày<input name="name" maxlength="160" placeholder="Ví dụ: Nghỉ Tết âm lịch" required/></label></div><div class="form-actions"><button class="btn-primary" type="submit">Thêm / cập nhật ngày nghỉ</button></div></form><form method="get" class="date-filter"><label>Năm xem<input type="number" name="year" min="2020" max="2100" value="@year"/></label><button class="btn-outline" type="submit">Xem lịch năm</button></form><div class="table-responsive"><table class="data-table"><thead><tr><th>NGÀY</th><th>TÊN NGÀY</th><th></th></tr></thead><tbody>@foreach(var h in holidays){<tr><td>@h.Date.ToString("dd/MM/yyyy")</td><td>@h.Name</td><td><form asp-action="DeleteCompanyHoliday" method="post"><input type="hidden" name="id" value="@h.Id"/><input type="hidden" name="year" value="@year"/><button class="btn-outline" type="submit">Xóa</button></form></td></tr>}</tbody></table></div>@if(holidays.Count==0){<div class="empty-state">Chưa khai báo ngày nghỉ nào cho năm @year.</div>}</section>
