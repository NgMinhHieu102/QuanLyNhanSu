@model List<HumaHr.Models.Employee>
@{ ViewData["Title"]="Nhân viên"; }
<section class="welcome-row"><div><div class="eyebrow"><span class="eyebrow-dot"></span> QUẢN LÝ ĐỘI NGŨ</div><h1>Danh sách nhân viên</h1><p class="page-subtitle">Quản lý thông tin và hồ sơ các thành viên trong công ty.</p></div><a class="btn-primary" asp-action="Employee"><span>＋</span> Thêm nhân viên</a></section>
<section class="panel list-panel"><div class="toolbar"><form method="get" class="filters"><div class="search-box"><span>⌕</span><input name="q" value="@ViewBag.Query" placeholder="Tìm tên, mã hoặc email..." /></div><select name="department" onchange="this.form.submit()"><option value="">Tất cả phòng ban</option>@foreach(var d in (List<HumaHr.Models.Department>)ViewBag.Departments){<option selected="@(ViewBag.Department==d.Name)" value="@d.Name">@d.Name</option>}</select><button class="btn-outline" type="submit">Lọc</button></form><span class="result-count">@Model.Count nhân viên</span></div><div class="table-responsive"><table class="data-table"><thead><tr><th>NHÂN VIÊN</th><th>PHÒNG BAN</th><th>VỊ TRÍ</th><th>NGÀY VÀO LÀM</th><th>LƯƠNG CƠ BẢN</th><th>TÀI KHOẢN</th><th>TRẠNG THÁI</th><th>THAO TÁC</th></tr></thead><tbody>@foreach(var e in Model){<tr><td><div class="person-cell"><span class="person-avatar avatar-@((e.Id%5)+1)">@e.FullName.Split(' ').Last()[0]</span><div><strong>@e.FullName</strong><small>@e.Code · @e.Email</small></div></div></td><td>@e.Department</td><td>@e.Position</td><td>@e.StartDate.ToString("dd/MM/yyyy")</td><td>@e.Salary.ToString("N0") ₫</td><td><span class="status-pill @(e.AccountStatus=="Đã cấp"?"active-pill":"inactive-pill")"><i></i>@e.AccountStatus</span></td><td><span class="status-pill @(e.IsActive?"active-pill":"inactive-pill")"><i></i> @(e.IsActive?"Đang làm việc":"Đã nghỉ")</span></td><td><div class="row-actions"><a asp-action="Employee" asp-route-id="@e.Id" title="Chỉnh sửa">✎ Sửa</a>@if(e.AccountStatus!="Chưa cấp"){<form asp-action="ResetEmployeePassword" method="post" onsubmit="return confirm('Cấp mật khẩu tạm mới? Mật khẩu hiện tại sẽ không dùng được nữa.')"><input type="hidden" name="id" value="@e.Id"/><button title="Cấp lại mật khẩu">Cấp lại MK</button></form>}<form asp-action="DeleteEmployee" method="post" onsubmit="return confirm('Xác nhận cho nhân viên nghỉ việc và khóa tài khoản?')"><input type="hidden" name="id" value="@e.Id"/><button title="Cho nghỉ việc">Cho nghỉ</button></form></div></td></tr>}</tbody></table></div>@if(Model.Count==0){<div class="empty-state">Không tìm thấy nhân viên phù hợp.</div>}</section>
