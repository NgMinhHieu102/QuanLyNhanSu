@model List<HumaHr.Models.Department>
@{ ViewData["Title"]="Báo cáo"; var employees=(List<HumaHr.Models.Employee>)ViewBag.Employees; }
<section class="welcome-row"><div><div class="eyebrow"><span class="eyebrow-dot"></span> PHÂN TÍCH & THỐNG KÊ</div><h1>Báo cáo nhân sự</h1><p class="page-subtitle">Bức tranh tổng thể về nguồn lực và chi phí nhân sự.</p></div><form method="get" class="date-filter"><input name="period" value="@ViewBag.PayrollPeriod" placeholder="MM/yyyy" pattern="(0[1-9]|1[0-2])/[0-9]{4}" required/><button class="btn-outline" type="submit">Xem kỳ</button></form><button class="btn-outline" onclick="window.print()">⇩ Xuất / In báo cáo</button></section><section class="stats-grid compact-stats"><article class="stat-card"><div class="stat-head"><span>Tổng hồ sơ nhân viên</span><span class="stat-icon purple">♙</span></div><div class="stat-value">@employees.Count <span>người</span></div></article><article class="stat-card"><div class="stat-head"><span>Đang làm việc</span><span class="stat-icon green">✓</span></div><div class="stat-value">@ViewBag.ActiveCount <span>người</span></div></article><article class="stat-card"><div class="stat-head"><span>Lương cơ bản TB · đang làm</span><span class="stat-icon blue">↗</span></div><div class="stat-value money">@(((decimal)ViewBag.AverageSalary).ToString("N0")) <span>₫</span></div></article><article class="stat-card"><div class="stat-head"><span>Tổng thực lĩnh đã công bố</span><span class="stat-icon orange">＄</span></div><div class="stat-value money">@(((decimal)ViewBag.TotalPayroll).ToString("N0")) <span>₫</span></div><div class="stat-foot">@ViewBag.PublishedPayrollCount phiếu lương · @ViewBag.PayrollPeriod</div></article></section><section class="panel report-panel"><div class="panel-heading"><div><h2>Phân bổ nhân sự theo phòng ban</h2><p>Số lượng nhân viên đang làm việc</p></div></div><div class="report-bars">@foreach(var d in Model){var activeCount=(int)ViewBag.ActiveCount;var width=activeCount==0?0:d.Headcount*100/activeCount;<div class="report-bar-row"><div><strong>@d.Name</strong><span>@d.Headcount nhân viên</span></div><div class="bar-track"><div class="bar-fill" style="width:@width%"></div></div></div>}</div></section>
