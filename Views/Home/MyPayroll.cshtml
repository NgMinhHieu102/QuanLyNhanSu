@model List<HumaHr.Models.Payroll>
@{ ViewData["Title"] = "Lương của tôi"; }
<section class="welcome-row"><div><div class="eyebrow"><span class="eyebrow-dot"></span> LƯƠNG CÁ NHÂN</div><h1>Phiếu lương của tôi</h1><p class="page-subtitle">Chỉ hiển thị phiếu đã được Admin chốt và công bố.</p></div><button class="btn-outline" onclick="window.print()">⇩ In phiếu lương</button></section>
@foreach(var p in Model){<section class="panel list-panel payslip"><div class="panel-heading"><div><h2>Kỳ lương @p.Period</h2><p>Công: @p.PaidDays / @p.ScheduledWorkDays ngày · Nghỉ không lương: @p.UnpaidDays</p></div><strong class="stat-value money">@p.NetSalary.ToString("N0") ₫</strong></div><div class="table-responsive"><table class="data-table"><tbody><tr><th colspan="2">THU NHẬP</th></tr><tr><td>Lương theo ngày công</td><td>@p.BasePay.ToString("N0") ₫</td></tr><tr><td>Tăng ca ngày thường (@p.RegularOvertimeHours.ToString("0.##") giờ × @((p.RegularOvertimeRateUsed*100).ToString("0.#"))%)</td><td>@p.RegularOvertimePay.ToString("N0") ₫</td></tr><tr><td>Tăng ca ngày nghỉ tuần (@p.RestOvertimeHours.ToString("0.##") giờ × @((p.RestOvertimeRateUsed*100).ToString("0.#"))%)</td><td>@p.RestOvertimePay.ToString("N0") ₫</td></tr><tr><td>Tăng ca ngày lễ (@p.HolidayOvertimeHours.ToString("0.##") giờ × @((p.HolidayOvertimeRateUsed*100).ToString("0.#"))%)</td><td>@p.HolidayOvertimePay.ToString("N0") ₫</td></tr><tr><td>Phụ trội làm đêm (@((p.NightPremiumRateUsed*100).ToString("0.#"))% + @((p.NightOvertimeAdditionalRateUsed*100).ToString("0.#"))% cho giờ tăng ca đêm)</td><td>@((p.NightPremium+p.NightOvertimePremium).ToString("N0")) ₫</td></tr><tr><td>Phụ cấp</td><td>@p.Allowance.ToString("N0") ₫</td></tr><tr><td>Thưởng</td><td>@p.Bonus.ToString("N0") ₫</td></tr><tr><th colspan="2">CÁC KHOẢN TRỪ</th></tr><tr><td>Bảo hiểm bắt buộc của người lao động (@((p.EmployeeInsuranceRateUsed*100).ToString("0.#"))% trên @p.InsuranceBase.ToString("N0") ₫)</td><td>@p.EmployeeInsurance.ToString("N0") ₫</td></tr><tr><td>Thuế thu nhập cá nhân</td><td>@p.PersonalIncomeTax.ToString("N0") ₫</td></tr><tr><td>Tạm ứng</td><td>@p.AdvanceDeduction.ToString("N0") ₫</td></tr><tr><td>Khoản trừ khác · @p.OtherDeductionReason</td><td>@p.OtherDeductions.ToString("N0") ₫</td></tr><tr><th>THỰC LĨNH</th><th>@p.NetSalary.ToString("N0") ₫</th></tr></tbody></table></div></section>}
@if(Model.Count==0){<section class="panel empty-state">Chưa có phiếu lương được công bố. Phiếu nháp và dữ liệu demo cũ không hiển thị tại đây.</section>}
