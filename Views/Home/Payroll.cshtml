@model List<HumaHr.Models.Payroll>
@{ ViewData["Title"]="Bảng lương"; var total=Model.Where(x=>x.IsCalculated&&x.Status=="Đã công bố").Sum(x=>x.NetSalary); var employees=(List<HumaHr.Models.Employee>)ViewBag.Employees; var period=(string)ViewBag.Period; var monthValue=(string)ViewBag.MonthValue; var currentMonth=DateTime.ParseExact(period,"MM/yyyy",System.Globalization.CultureInfo.InvariantCulture); var settings=(HumaHr.Models.PayrollSettings)ViewBag.Settings; }
<section class="welcome-row"><div><div class="eyebrow"><span class="eyebrow-dot"></span> LƯƠNG & PHÚC LỢI</div><h1>Bảng lương kỳ @period</h1><p class="page-subtitle">Lập bản nháp từ bảng công đã chốt, rà soát từng khoản rồi mới công bố.</p></div><div class="form-actions"><a class="btn-outline" asp-action="PayrollSettings">⚙ Lịch làm & ngày nghỉ</a><button class="btn-outline" onclick="window.print()">⇩ In</button></div></section>
<section class="panel list-panel"><div class="panel-heading"><div><h2>Lọc kỳ lương</h2><p>Tổng thực lĩnh đã công bố: <strong>@total.ToString("N0") ₫</strong></p></div><div class="form-actions"><a class="btn-outline" asp-action="Payroll" asp-route-period="@currentMonth.AddMonths(-1).ToString("MM/yyyy")">← Tháng trước</a><form method="get" class="date-filter"><input type="month" name="month" value="@monthValue" required/><button class="btn-outline" type="submit">Xem tháng</button></form><a class="btn-outline" asp-action="Payroll" asp-route-period="@currentMonth.AddMonths(1).ToString("MM/yyyy")">Tháng sau →</a></div></div></section>
<section class="panel form-panel"><h2>Tính lương từ bảng công</h2><p class="page-subtitle">Cần ghi nhận đủ mọi ngày làm theo lịch trong kỳ. Ngày chưa chấm công sẽ chặn việc tính lương.</p><form asp-action="GeneratePayroll" method="post"><div class="form-grid"><label>Nhân viên<select name="employeeId" required>@foreach(var e in employees){<option value="@e.Id">@e.FullName · @e.Code · lương HĐ @e.Salary.ToString("N0") ₫</option>}</select></label><label>Kỳ lương (MM/yyyy)<input name="period" value="@period" pattern="(0[1-9]|1[0-2])/[0-9]{4}" required/></label><label>Phụ cấp kỳ này (₫)<input name="allowance" type="number" min="0" step="1000" value="0" required/></label><label>Thưởng (₫)<input name="bonus" type="number" min="0" step="1000" value="0" required/></label><label>Lương làm căn cứ đóng BH (₫)<input name="insuranceBase" type="number" min="0" step="1000" value="0"/><small>Để 0 dùng lương hợp đồng; nhập mức căn cứ khác nếu hồ sơ đã xác định.</small></label><label class="checkbox-field"><input name="insuranceEligible" type="checkbox" value="true" checked/> Có tham gia bảo hiểm bắt buộc<input type="hidden" name="insuranceEligible" value="false"/></label><label>Thuế TNCN đã tính (₫)<input name="personalIncomeTax" type="number" min="0" step="1000" value="0" required/><small>Admin nhập theo hồ sơ giảm trừ và quy định thuế; hệ thống không tự đoán người phụ thuộc.</small></label><label class="checkbox-field"><input name="taxReviewed" type="checkbox" value="true" required/> Đã rà soát thuế TNCN và giảm trừ cá nhân<input type="hidden" name="taxReviewed" value="false"/></label><label>Tạm ứng (₫)<input name="advanceDeduction" type="number" min="0" step="1000" value="0" required/></label><label>Khoản trừ khác có căn cứ (₫)<input name="otherDeductions" type="number" min="0" step="1000" value="0" required/></label><label>Căn cứ khoản trừ khác (bắt buộc nếu số tiền &gt; 0)<input name="otherDeductionReason" maxlength="300"/></label></div><div class="form-actions"><button class="btn-primary" type="submit" disabled="@(employees.Count==0)">Tính và lưu bản nháp</button></div></form><p class="page-subtitle">Tăng ca lấy từ bảng chấm công: ngày làm theo lịch × @settings.RegularOvertimeRate.ToString("0.##") · ngày nghỉ tuần × @settings.RestOvertimeRate.ToString("0.##") · ngày lễ đã cấu hình × @settings.HolidayOvertimeRate.ToString("0.##"). Bảo hiểm nhân viên @((settings.EmployeeInsuranceRate*100).ToString("0.##"))%; phần doanh nghiệp @((settings.EmployerContributionRate*100).ToString("0.##"))% hiển thị riêng.</p></section>
<section class="panel list-panel payroll-list" id="payroll-list">
<div class="payroll-toolbar"><div><h2>Danh sách lương nhân viên</h2><p class="page-subtitle">Nhân viên chưa có phiếu được ghi rõ “Chưa tính lương”.</p></div><label>Số dòng mỗi trang <select id="payroll-page-size"><option value="5">5</option><option value="10" selected>10</option><option value="all">Tất cả</option></select></label></div>
<div class="table-responsive"><table class="data-table"><thead><tr><th>NHÂN VIÊN / TRẠNG THÁI</th><th>CÔNG</th><th>LƯƠNG CÔNG</th><th>TĂNG CA THƯỜNG</th><th>TĂNG CA NGHỈ TUẦN</th><th>TĂNG CA NGÀY LỄ</th><th>PHỤ CẤP + THƯỞNG</th><th>BH NHÂN VIÊN</th><th>THUẾ</th><th>TẠM ỨNG / KHÁC</th><th>BH DOANH NGHIỆP</th><th>THỰC LĨNH</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td><strong>@p.EmployeeName</strong><br/><small>@p.Department · @(p.IsCalculated?p.Status:"Dữ liệu cũ · chưa đối soát")</small>@if(p.Status=="Cần tính lại"){<br/><small class="text-warning">Bảng công đã đổi — phiếu chưa cập nhật</small>}else if(p.Status=="Cần điều chỉnh"){<br/><small class="text-warning">Đã mở khóa điều chỉnh</small><br/><small>@p.AdjustmentReason</small>}</td>@if(p.IsCalculated){<td>@p.PaidDays / @p.ScheduledWorkDays ngày<br/><small>Nghỉ không lương: @p.UnpaidDays</small></td><td>@p.BasePay.ToString("N0") ₫</td><td>@p.RegularOvertimeHours.ToString("0.##") giờ<br/><small>@p.RegularOvertimePay.ToString("N0") ₫</small></td><td>@p.RestOvertimeHours.ToString("0.##") giờ<br/><small>@p.RestOvertimePay.ToString("N0") ₫</small></td><td>@p.HolidayOvertimeHours.ToString("0.##") giờ<br/><small>@p.HolidayOvertimePay.ToString("N0") ₫</small><br/><small>Đêm: @p.NightPremium.ToString("N0") ₫ + @p.NightOvertimePremium.ToString("N0") ₫</small></td><td>@((p.Allowance+p.Bonus).ToString("N0")) ₫</td><td>@p.EmployeeInsurance.ToString("N0") ₫<br/><small>Căn cứ @p.InsuranceBase.ToString("N0")</small></td><td>@p.PersonalIncomeTax.ToString("N0") ₫</td><td>@((p.AdvanceDeduction+p.OtherDeductions).ToString("N0")) ₫<br/><small>@p.OtherDeductionReason</small></td><td>@p.EmployerContributions.ToString("N0") ₫</td><td><strong>@p.NetSalary.ToString("N0") ₫</strong></td><td>@if(p.Status is "Bản nháp" or "Cần tính lại" or "Cần điều chỉnh"){<button type="button" class="btn-outline" onclick="document.getElementById('payroll-edit-@p.Id').showModal()">Sửa</button><dialog id="payroll-edit-@p.Id" class="payroll-dialog"><div class="payroll-dialog-head"><strong>Sửa khoản lương · @p.EmployeeName</strong><button type="button" class="dialog-close" onclick="this.closest('dialog').close()" aria-label="Đóng">×</button></div><form asp-action="UpdatePayrollDraft" method="post" class="payroll-edit-form"><input type="hidden" name="id" value="@p.Id"/><label>Phụ cấp<input type="number" name="allowance" min="0" step="1000" value="@p.Allowance" required/></label><label>Thưởng<input type="number" name="bonus" min="0" step="1000" value="@p.Bonus" required/></label><label>Căn cứ đóng bảo hiểm<input type="number" name="insuranceBase" min="0" step="1000" value="@p.InsuranceBase" required/></label><label><input type="checkbox" name="insuranceEligible" value="true" checked="@(p.EmployeeInsuranceRateUsed>0)"/> Tham gia bảo hiểm<input type="hidden" name="insuranceEligible" value="false"/></label><label>Thuế TNCN<input type="number" name="personalIncomeTax" min="0" step="1000" value="@p.PersonalIncomeTax" required/></label><label>Tạm ứng<input type="number" name="advanceDeduction" min="0" step="1000" value="@p.AdvanceDeduction" required/></label><label>Khoản trừ khác<input type="number" name="otherDeductions" min="0" step="1000" value="@p.OtherDeductions" required/></label><label>Căn cứ khoản trừ<input name="otherDeductionReason" maxlength="300" value="@p.OtherDeductionReason"/></label><label><input type="checkbox" name="taxReviewed" value="true" required/> Đã rà soát thuế TNCN</label><div class="payroll-dialog-actions"><button type="button" class="btn-outline" onclick="this.closest('dialog').close()">Hủy</button><button class="btn-primary" type="submit">Lưu và tính lại</button></div></form></dialog>}@if(p.Status=="Bản nháp"){<form asp-action="PublishPayroll" method="post" onsubmit="return confirm('Công bố phiếu lương cho nhân viên? Sau khi công bố sẽ bị khóa.')"><input type="hidden" name="id" value="@p.Id"/><input type="hidden" name="period" value="@period"/><button class="btn-primary" type="submit">Công bố</button></form><form asp-action="DeletePayroll" method="post"><input type="hidden" name="id" value="@p.Id"/><input type="hidden" name="period" value="@period"/><button class="btn-outline" type="submit">Xóa nháp</button></form>}else if(p.Status=="Cần tính lại"||p.Status=="Cần điều chỉnh"){<form asp-action="RecalculatePayroll" method="post"><input type="hidden" name="id" value="@p.Id"/><label class="checkbox-field"><input type="checkbox" name="taxReviewed" value="true" required/> Đã rà soát thuế</label><button class="btn-primary" type="submit">Tính lại</button></form>}else if(p.Status=="Đã công bố"){<details><summary>Điều chỉnh</summary><form asp-action="ReopenPayrollForAdjustment" method="post"><input type="hidden" name="id" value="@p.Id"/><input name="reason" maxlength="300" placeholder="Lý do mở lại" required/><button class="btn-outline" type="submit">Mở khóa</button></form></details>}</td>}else{<td colspan="11">Số cũ: lương @p.BaseSalary.ToString("N0") ₫ · phụ cấp @p.Allowance.ToString("N0") ₫ · khấu trừ mẫu @p.Deduction.ToString("N0") ₫. Không đưa vào thực lĩnh đã công bố.</td><td>—</td>}</tr>}
@foreach(var e in employees.Where(e => !Model.Any(p => p.EmployeeId == e.Id)))
{
<tr><td><strong>@e.FullName</strong><br/><small>@e.Code · Chưa tính lương</small></td><td colspan="11">Chưa có phiếu lương trong kỳ @period.</td><td><button type="button" class="btn-outline" data-payroll-employee="@e.Id">Tính lương</button></td></tr>
}
</tbody></table></div>@if(Model.Count==0 && employees.Count==0){<div class="empty-state">Kỳ này chưa có phiếu lương. Hoàn tất chấm công trước khi tính.</div>}
<div class="payroll-pagination" id="payroll-pagination" hidden><span id="payroll-range" role="status" aria-live="polite"></span><nav aria-label="Phân trang bảng lương"><button type="button" class="btn-outline" id="payroll-prev">← Trước</button><span id="payroll-page"></span><button type="button" class="btn-outline" id="payroll-next">Sau →</button></nav></div></section>
@section Scripts {
<script src="~/js/payroll.js" asp-append-version="true"></script>
}
