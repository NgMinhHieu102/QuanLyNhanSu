@model HumaHr.Models.Employee
@{ ViewData["Title"] = "Cập nhật hồ sơ"; var requests=(List<HumaHr.Models.ProfileChangeRequest>)ViewBag.Requests; }
<section class="welcome-row"><div><div class="eyebrow"><span class="eyebrow-dot"></span> HỒ SƠ CÁ NHÂN</div><h1>Yêu cầu cập nhật hồ sơ</h1><p class="page-subtitle">Email và số điện thoại sẽ được cập nhật sau khi quản lý duyệt.</p></div></section>
<section class="panel form-panel"><h2>Thông tin hiện tại</h2><p>Email: <strong>@Model.Email</strong> · Điện thoại: <strong>@Model.Phone</strong></p><form asp-action="SubmitProfileChange" method="post"><div class="form-grid"><label>Email mới<input name="email" type="email" maxlength="160" value="@Model.Email" required/></label><label>Số điện thoại mới<input name="phone" maxlength="30" value="@Model.Phone" required/></label><label>Lý do thay đổi<input name="reason" maxlength="300" required/></label></div><div class="form-actions"><button class="btn-primary" type="submit">Gửi yêu cầu</button></div></form></section>
<section class="panel list-panel"><h2>Lịch sử yêu cầu</h2><div class="table-responsive"><table class="data-table"><thead><tr><th>NGÀY GỬI</th><th>EMAIL ĐỀ XUẤT</th><th>ĐIỆN THOẠI</th><th>LÝ DO</th><th>TRẠNG THÁI</th></tr></thead><tbody>@foreach(var x in requests){<tr><td>@x.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@x.ProposedEmail</td><td>@x.ProposedPhone</td><td>@x.Reason</td><td>@x.Status</td></tr>}</tbody></table></div></section>
