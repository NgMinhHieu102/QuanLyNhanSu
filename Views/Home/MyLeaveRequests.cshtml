@model List<HumaHr.Models.LeaveRequest>
@{ ViewData["Title"] = "Nghỉ phép"; }
<section class="welcome-row"><div><div class="eyebrow"><span class="eyebrow-dot"></span> NGHỈ PHÉP</div><h1>Đơn nghỉ phép</h1><p class="page-subtitle">Gửi yêu cầu và theo dõi phản hồi từ quản lý.</p></div></section>
<section class="panel form-panel"><h2>Tạo yêu cầu nghỉ</h2><form asp-action="SubmitLeaveRequest" method="post"><div class="form-grid"><label>Loại nghỉ<select name="leaveType"><option>Nghỉ phép năm có lương</option><option>Nghỉ không lương</option><option>Nghỉ ốm (chế độ BHXH)</option></select></label><label>Từ ngày<input type="date" name="startDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" required/></label><label>Đến ngày<input type="date" name="endDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" required/></label><label>Lý do<textarea name="reason" maxlength="500" required></textarea></label></div><div class="form-actions"><button class="btn-primary" type="submit">Gửi đơn</button></div></form><p class="page-subtitle">Ngày cuối tuần và ngày nghỉ của công ty không trừ vào phép năm. Nghỉ ốm cần hồ sơ hưởng chế độ BHXH.</p></section>
<section class="panel list-panel"><div class="table-responsive"><table class="data-table"><thead><tr><th>LOẠI NGHỈ</th><th>THỜI GIAN</th><th>LÝ DO</th><th>TRẠNG THÁI</th><th>PHẢN HỒI</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.LeaveType</td><td>@x.StartDate.ToString("dd/MM/yyyy") – @x.EndDate.ToString("dd/MM/yyyy")</td><td>@x.Reason</td><td>@x.Status</td><td>@x.AdminNote</td></tr>}</tbody></table></div>@if(Model.Count==0){<div class="empty-state">Bạn chưa gửi đơn nghỉ nào.</div>}</section>
