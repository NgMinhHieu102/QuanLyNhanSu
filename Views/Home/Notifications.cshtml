@{ ViewData["Title"] = "Thông báo"; var missing=(List<HumaHr.Models.Employee>)ViewBag.MissingAttendance; var late=(List<HumaHr.Models.Attendance>)ViewBag.LateAttendance; var early=(List<HumaHr.Models.Attendance>)ViewBag.EarlyAttendance; var employeeCodes=(Dictionary<int,string>)ViewBag.EmployeeCodes; var employeeNames=(Dictionary<int,string>)ViewBag.EmployeeNames; }
<section class="welcome-row"><div><div class="eyebrow"><span class="eyebrow-dot"></span> CẬP NHẬT HÔM NAY</div><h1>Thông báo</h1><p class="page-subtitle">Các mục cần chú ý trong chấm công ngày @DateTime.Today.ToString("dd/MM/yyyy").</p></div><a class="btn-outline" asp-action="Attendance">Mở chấm công →</a></section>
<section class="panel info-panel notification-panel"><h2>Đi muộn hôm nay <span class="notification-total">@late.Count</span></h2>@if(late.Count==0){<p class="page-subtitle">Chưa có trường hợp đi muộn được ghi nhận.</p>}else{<ul class="notice-list">@foreach(var a in late){<li><span><strong>@employeeNames.GetValueOrDefault(a.EmployeeId, a.EmployeeName)</strong><small>@employeeCodes.GetValueOrDefault(a.EmployeeId, $"ID {a.EmployeeId}") · Chấm vào lúc @(a.CheckInAt?.ToString("HH:mm") ?? "Chưa ghi giờ")</small></span><a asp-action="Attendance">Xem chấm công</a></li>}</ul>}</section>
<section class="panel info-panel notification-panel"><h2>Về sớm hôm nay <span class="notification-total">@early.Count</span></h2>@if(early.Count==0){<p class="page-subtitle">Chưa có trường hợp về sớm được ghi nhận.</p>}else{<ul class="notice-list">@foreach(var a in early){<li><span><strong>@employeeNames.GetValueOrDefault(a.EmployeeId, a.EmployeeName)</strong><small>@employeeCodes.GetValueOrDefault(a.EmployeeId, $"ID {a.EmployeeId}") · Chấm ra lúc @(a.CheckOutAt?.ToString("HH:mm") ?? "Chưa ghi giờ")</small></span><a asp-action="Attendance">Xem chấm công</a></li>}</ul>}</section>
<section class="panel info-panel notification-panel"><h2>Chưa ghi nhận chấm công <span class="notification-total">@missing.Count</span></h2>@if(missing.Count==0){<p class="page-subtitle">Tất cả nhân viên đang hoạt động đã có dữ liệu chấm công hôm nay.</p>}else{<ul class="notice-list">@foreach(var e in missing){<li><span><strong>@e.FullName</strong><small>@e.Code · @e.Department</small></span><a asp-action="Attendance">Cập nhật</a></li>}</ul>}</section>
