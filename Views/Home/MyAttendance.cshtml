@model List<HumaHr.Models.Attendance>
@{ ViewData["Title"] = "Chấm công của tôi"; var employee = (HumaHr.Models.Employee)ViewBag.Employee; var canCheckIn=(bool)ViewBag.CanCheckIn; var canCheckOut=(bool)ViewBag.CanCheckOut; var punchNotice=(string)ViewBag.PunchNotice; }
<section class="welcome-row"><div><div class="eyebrow"><span class="eyebrow-dot"></span> CHẤM CÔNG CÁ NHÂN</div><h1>Lịch sử chấm công</h1><p class="page-subtitle">@employee.FullName · @employee.Code</p></div><div class="form-actions"><form asp-action="CheckIn" method="post"><button class="btn-primary" type="submit" disabled="@(!canCheckIn)">Chấm công vào</button></form><form asp-action="CheckOut" method="post"><button class="btn-outline" type="submit" disabled="@(!canCheckOut)">Chấm công ra</button></form></div></section>
@if(!string.IsNullOrWhiteSpace(punchNotice)){<section class="panel info-panel"><p>@punchNotice</p></section>}
<section class="panel list-panel"><div class="table-responsive"><table class="data-table"><thead><tr><th>NGÀY</th><th>GIỜ VÀO</th><th>GIỜ RA</th><th>TRẠNG THÁI</th><th>TĂNG CA</th></tr></thead><tbody>@foreach (var item in Model){<tr><td>@item.Date.ToString("dd/MM/yyyy")</td><td>@(item.CheckInAt?.ToString("HH:mm") ?? "—")</td><td>@(item.CheckOutAt?.ToString("HH:mm") ?? "—")</td><td>@if(item.IsLate || item.LeftEarly){if(item.IsLate && item.LeftEarly){<span>Đi muộn · Về sớm</span>}else if(item.IsLate){<span>Đi muộn</span>}else{<span>Về sớm</span>}}else{@item.Status}</td><td>@item.OvertimeHours.ToString("0.#") giờ</td></tr>}</tbody></table></div>@if(Model.Count==0){<div class="empty-state">Chưa có dữ liệu chấm công.</div>}</section>
