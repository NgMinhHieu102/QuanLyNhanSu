@{ ViewData["Title"] = "Yêu cầu nhân viên"; var leaves=(List<HumaHr.Models.LeaveRequest>)ViewBag.Leaves; var profiles=(List<HumaHr.Models.ProfileChangeRequest>)ViewBag.ProfileChanges; var resets=(List<HumaHr.Models.PasswordResetRequest>)ViewBag.PasswordResets; }
<section class="welcome-row"><div><div class="eyebrow"><span class="eyebrow-dot"></span> TỰ PHỤC VỤ NHÂN VIÊN</div><h1>Yêu cầu nhân viên</h1><p class="page-subtitle">Duyệt nghỉ phép, thay đổi hồ sơ và xử lý quên mật khẩu.</p></div></section>
<section class="panel list-panel"><h2>Đơn nghỉ</h2><div class="table-responsive"><table class="data-table"><thead><tr><th>NHÂN VIÊN / LOẠI</th><th>THỜI GIAN</th><th>LÝ DO</th><th>TRẠNG THÁI</th><th>DUYỆT</th></tr></thead><tbody>@foreach(var x in leaves){<tr><td>@x.EmployeeName<br/><small>@x.LeaveType</small></td><td>@x.StartDate.ToString("dd/MM/yyyy") – @x.EndDate.ToString("dd/MM/yyyy")</td><td>@x.Reason</td><td>@x.Status @if(!string.IsNullOrWhiteSpace(x.AdminNote)){<small>@x.AdminNote</small>}</td><td>@if(x.Status=="Chờ duyệt"){<form asp-action="ReviewLeaveRequest" method="post" class="row-actions"><input type="hidden" name="id" value="@x.Id"/><input name="note" placeholder="Ghi chú"/><button class="btn-outline" name="approve" value="true">Duyệt</button><button class="btn-outline" name="approve" value="false">Từ chối</button></form>}</td></tr>}</tbody></table></div>@if(leaves.Count==0){<div class="empty-state">Chưa có đơn nghỉ phép.</div>}</section>
<section class="panel list-panel"><h2>Yêu cầu cập nhật hồ sơ</h2><div class="table-responsive"><table class="data-table"><thead><tr><th>NHÂN VIÊN</th><th>EMAIL MỚI</th><th>ĐIỆN THOẠI MỚI</th><th>LÝ DO</th><th>TRẠNG THÁI</th><th>XỬ LÝ</th></tr></thead><tbody>@foreach(var x in profiles){<tr><td>@x.EmployeeName</td><td>@x.ProposedEmail</td><td>@x.ProposedPhone</td><td>@x.Reason</td><td>@x.Status</td><td>@if(x.Status=="Chờ duyệt"){<form asp-action="ReviewProfileRequest" method="post" class="row-actions"><input type="hidden" name="id" value="@x.Id"/><button name="approve" value="true">Duyệt</button><button name="approve" value="false">Từ chối</button></form>}</td></tr>}</tbody></table></div></section>
<section class="panel list-panel"><h2>Yêu cầu đặt lại mật khẩu</h2><div class="table-responsive"><table class="data-table"><thead><tr><th>NHÂN VIÊN</th><th>EMAIL</th><th>NGÀY GỬI</th><th>TRẠNG THÁI</th><th>XỬ LÝ</th></tr></thead><tbody>@foreach(var x in resets){<tr><td>@x.EmployeeName</td><td>@x.Email</td><td>@x.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@x.Status</td><td>@if(x.Status=="Chờ xử lý"){<form asp-action="ResetFromRequest" method="post" onsubmit="return confirm('Cấp mật khẩu tạm mới cho nhân viên này?')"><input type="hidden" name="id" value="@x.Id"/><button class="btn-outline" type="submit">Cấp mật khẩu tạm</button></form>}</td></tr>}</tbody></table></div>@if(resets.Count==0){<div class="empty-state">Không có yêu cầu đặt lại mật khẩu.</div>}</section>
