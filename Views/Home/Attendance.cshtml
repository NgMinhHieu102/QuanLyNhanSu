@model List<HumaHr.Models.Attendance>
@{ ViewData["Title"]="Chấm công"; var selectedDate=(DateTime)ViewBag.SelectedDate; var employees=(List<HumaHr.Models.Employee>)ViewBag.Employees; var records=Model.ToDictionary(x=>x.EmployeeId); var present=Model.Count(x=>x.Status=="Có mặt"); }
<section class="welcome-row"><div><div class="eyebrow"><span class="eyebrow-dot"></span> CHẤM CÔNG & NGHỈ PHÉP</div><h1>Chấm công</h1><p class="page-subtitle">Theo dõi giờ vào, giờ ra, đi muộn và về sớm.</p></div><form method="get" class="date-filter"><input type="date" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")"/><button class="btn-outline" type="submit">Xem ngày</button></form></section>
<section class="stats-grid compact-stats"><article class="stat-card"><div class="stat-head"><span>Tổng nhân viên</span><span class="stat-icon purple">♙</span></div><div class="stat-value">@employees.Count <span>người</span></div></article><article class="stat-card"><div class="stat-head"><span>Có mặt</span><span class="stat-icon green">✓</span></div><div class="stat-value">@present <span>người</span></div></article><article class="stat-card"><div class="stat-head"><span>Đi muộn</span><span class="stat-icon orange">◷</span></div><div class="stat-value">@Model.Count(x=>x.IsLate) <span>người</span></div></article><article class="stat-card"><div class="stat-head"><span>Về sớm</span><span class="stat-icon blue">↙</span></div><div class="stat-value">@Model.Count(x=>x.LeftEarly) <span>người</span></div></article></section>
<section class="panel list-panel"><div class="panel-heading"><div><h2>Bảng điểm danh</h2><p>Ngày @selectedDate.ToString("dd/MM/yyyy")</p></div><span class="result-count">Chọn trạng thái trong dropdown: đi muộn, về sớm hoặc cả hai.</span></div><div class="table-responsive"><table class="data-table"><thead><tr><th>NHÂN VIÊN</th><th>TRẠNG THÁI</th><th>TĂNG CA (GIỜ)</th><th>GIỜ ĐÊM (THƯỜNG / TĂNG CA)</th><th>CẬP NHẬT</th></tr></thead><tbody>
@foreach(var e in employees){ records.TryGetValue(e.Id,out var a); var statusText=a is null?"Chưa ghi nhận":a.IsLate&&a.LeftEarly?"Đi muộn và về sớm":a.IsLate?"Đi muộn":a.LeftEarly?"Về sớm":a.Status;
<tr><td><div class="person-cell"><span class="person-avatar avatar-@((e.Id%5)+1)">@e.FullName.Split(' ').Last()[0]</span><div><strong>@e.FullName</strong><small>@e.Code · @e.Department</small></div></div></td><td><span class="status-pill @(a?.Status=="Có mặt"?"active-pill":a is null?"inactive-pill":"late-pill")"><i></i>@statusText</span></td><td>@(a?.OvertimeHours.ToString("0.#") ?? "0")</td><td>@(a?.NightHours.ToString("0.#") ?? "0") / @(a?.NightOvertimeHours.ToString("0.#") ?? "0") giờ</td><td><form asp-action="SaveAttendance" method="post" class="attendance-edit"><input type="hidden" name="employeeId" value="@e.Id"/><input type="hidden" name="date" value="@selectedDate.ToString("yyyy-MM-dd")"/><select name="status" aria-label="Trạng thái của @e.FullName"><option value="Có mặt" selected="@(a is null || (a.Status is "Có mặt" or "Đi muộn") && !a.IsLate && !a.LeftEarly)">Có mặt</option><option value="Đi muộn" selected="@(a?.IsLate==true && a?.LeftEarly!=true)">Đi muộn</option><option value="Về sớm" selected="@(a?.IsLate!=true && a?.LeftEarly==true)">Về sớm</option><option value="Đi muộn và về sớm" selected="@(a?.IsLate==true && a?.LeftEarly==true)">Đi muộn và về sớm</option><option value="Vắng mặt" selected="@(a?.Status=="Vắng mặt")">Vắng mặt</option><option value="Nghỉ phép" selected="@(a?.Status=="Nghỉ phép")">Nghỉ phép</option></select><input name="overtimeHours" type="number" min="0" max="24" step="0.5" value="@(a?.OvertimeHours ?? 0)" aria-label="Số giờ tăng ca"/><input name="nightHours" type="number" min="0" max="24" step="0.5" value="@(a?.NightHours ?? 0)" aria-label="Số giờ làm đêm thường"/><input name="nightOvertimeHours" type="number" min="0" max="24" step="0.5" value="@(a?.NightOvertimeHours ?? 0)" aria-label="Số giờ tăng ca ban đêm"/><button class="btn-outline" type="submit">Lưu</button></form></td></tr>
}
</tbody></table></div>@if(employees.Count==0){<div class="empty-state">Chưa có nhân viên trong hệ thống.</div>}</section>
