@{ ViewData["Title"] = "Quên mật khẩu"; Layout = "_AccountLayout"; }
<section class="account-card"><a class="brand account-brand" asp-controller="Account" asp-action="Login"><span class="brand-mark">H</span><span>HTĐ</span></a><h1>Yêu cầu đặt lại mật khẩu</h1><p class="page-subtitle">Nhập email tài khoản nhân viên. Quản trị viên sẽ xử lý yêu cầu và cấp mật khẩu tạm.</p>@if(TempData["Message"] is string message){<div class="credential-message">@message</div>}<form asp-action="ForgotPassword" method="post" class="account-form"><label>Email đăng nhập<input name="email" type="email" autocomplete="email" required maxlength="160"/></label><button class="btn-primary" type="submit">Gửi yêu cầu</button></form><p class="account-switch"><a asp-action="Login">Quay lại đăng nhập</a></p></section>
