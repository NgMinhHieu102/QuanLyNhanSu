@model HumaHr.Models.ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; Layout = "_AccountLayout"; }
<section class="account-card"><a class="brand account-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">H</span><span>HTĐ</span></a><h1>Đổi mật khẩu</h1><p class="page-subtitle">Vì lý do bảo mật, hãy đặt mật khẩu riêng trước khi tiếp tục.</p><form asp-action="ChangePassword" method="post" class="account-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label>Mật khẩu hiện tại<input asp-for="CurrentPassword" autocomplete="current-password"/><span asp-validation-for="CurrentPassword"></span></label><label>Mật khẩu mới<input asp-for="NewPassword" autocomplete="new-password"/><span asp-validation-for="NewPassword"></span></label><label>Nhập lại mật khẩu mới<input asp-for="ConfirmPassword" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword"></span></label><button class="btn-primary" type="submit">Lưu mật khẩu mới</button></form></section>
