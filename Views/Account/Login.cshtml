@model HumaHr.Models.LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; Layout = "_AccountLayout"; }
<section class="account-card">
    <a class="brand account-brand" asp-controller="Account" asp-action="Login"><span class="brand-mark">H</span><span>HTĐ</span></a>
    <h1>Chào mừng trở lại</h1><p class="page-subtitle">Đăng nhập để tiếp tục quản lý nhân sự.</p>
    <form asp-action="Login" method="post" class="account-form">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label>Email<input asp-for="Email" type="email" autocomplete="email" placeholder="ten@congty.vn"/><span asp-validation-for="Email"></span></label>
        <label>Mật khẩu<input asp-for="Password" autocomplete="current-password" placeholder="Nhập mật khẩu"/><span asp-validation-for="Password"></span></label>
        <button class="btn-primary" type="submit">Đăng nhập</button>
    </form>
    <p class="account-switch"><a asp-action="ForgotPassword">Quên mật khẩu?</a></p>
    <p class="account-switch">Đăng nhập bằng tài khoản quản trị được cấp.</p>
</section>
